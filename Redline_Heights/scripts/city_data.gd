class_name CityData
extends RefCounted
## The island's layout, generated by tools/gen_world.py: zones, terrain heights, road graph, blocks and features.

const Z_SEA := 0
const Z_BEACH := 1
const Z_URBAN := 2
const Z_DOWNTOWN := 3
const Z_PARK := 4
const Z_DESERT := 5
const Z_MOUNTAIN := 6
const Z_AIRPORT := 7
const Z_INDUSTRIAL := 8
const Z_LAKE := 9
const Z_STADIUM := 10

const ZONE_N := 600          # zone grid is 600 x 600 over the whole map (4 m cells)
const HEIGHT_N := 301        # height grid is 301 x 301 vertices (8 m)

static var is_loaded := false
static var half := 3500.0
static var pitch := 76.0
static var road_w := 16.0
static var nodes := PackedVector2Array()
static var node_kind := PackedInt32Array()   # 0 junction / corner / straight, 1 roundabout ring, 2 turnaround circle
const LOOP_X0 := 536.0
const LOOP_X1 := 1139.0
const LOOP_Z0 := -1114.0
const LOOP_Z1 := -718.0
const RING_C := Vector2(700.0, -826.0)      # roundabout in front of the terminal
const RING_R := 15.0                         # radius the cars follow
const RING_OUT := 21.0                       # outer edge of the ring road
const ARC_STUB := 24.0                        # length of the straight road between a grid corner and its half-circle boulevard
const RING_IN := 9.0                         # edge of the central island
const TURN_R := 11.0                         # turnaround circle at the end of the forecourt road
static var edges: Array = []           # [a, b, kind]  kind 0 street, 1 highway, 2 connector (no mesh)
static var adj: Array = []             # per node: Array of {n: neighbour, e: edge index}
static var cells: Array = []           # [k, m, kind]
static var hw: Dictionary = {}
static var features: Dictionary = {}
static var pois: Array = []
static var _zones := PackedByteArray()
static var _heights := PackedFloat32Array()

## Town crossroads (metres) and the road out to the airport gate. Everything else is flat open land.
const TOWN_X := [-382.0, -191.0, 0.0, 191.0, 382.0]
const TOWN_Z := [-382.0, -191.0, 0.0, 191.0, 382.0]
const AIRPORT_GATE := Vector2(700.0, -750.0)

static func load_all() -> void:
	if is_loaded: return
	half = 3500.0
	pitch = 76.0
	road_w = 12.0
	nodes = PackedVector2Array()
	edges = []
	var id := {}
	for xi in range(TOWN_X.size()):
		for zi in range(TOWN_Z.size()):
			id[Vector2i(xi, zi)] = nodes.size()
			nodes.append(Vector2(TOWN_X[xi], TOWN_Z[zi]))
	for xi in range(TOWN_X.size()):
		for zi in range(TOWN_Z.size()):
			if xi + 1 < TOWN_X.size(): edges.append([id[Vector2i(xi, zi)], id[Vector2i(xi + 1, zi)], 0])
			if zi + 1 < TOWN_Z.size(): edges.append([id[Vector2i(xi, zi)], id[Vector2i(xi, zi + 1)], 0])
	# the airport road: north from the town's north-east crossroad, east to x=700, north through the gate to the
	# roundabout in front of the terminal; two forecourt arms leave it and finish in turnaround circles
	var chain := [Vector2(382.0, -650.0), Vector2(700.0, -650.0)]
	var prev: int = id[Vector2i(4, 0)]
	for pt in chain:
		var ni := nodes.size()
		nodes.append(pt)
		edges.append([prev, ni, 0])
		prev = ni
	var approach_end := prev
	var gate_id := nodes.size()
	nodes.append(AIRPORT_GATE)
	var ring: Array = []
	for k in range(8):
		var th := k * TAU / 8.0
		ring.append(nodes.size())
		nodes.append(RING_C + Vector2(sin(th), cos(th)) * RING_R)
	for k in range(8):
		edges.append([ring[k], ring[(k + 1) % 8], 4])
	# a loop road right round the airport, just outside the fence, so nothing in the game ends in a dead end.
	# The south side meets the approach road in front of the gate; the roundabout's east and west arms join the loop.
	var loop_sw := nodes.size(); nodes.append(Vector2(LOOP_X0, LOOP_Z1))
	var loop_js := nodes.size(); nodes.append(Vector2(AIRPORT_GATE.x, LOOP_Z1))
	var loop_se := nodes.size(); nodes.append(Vector2(LOOP_X1, LOOP_Z1))
	var loop_je := nodes.size(); nodes.append(Vector2(LOOP_X1, RING_C.y))
	var loop_ne := nodes.size(); nodes.append(Vector2(LOOP_X1, LOOP_Z0))
	var loop_nw := nodes.size(); nodes.append(Vector2(LOOP_X0, LOOP_Z0))
	var loop_jw := nodes.size(); nodes.append(Vector2(LOOP_X0, RING_C.y))
	for pr in [[loop_sw, loop_js], [loop_js, loop_se], [loop_se, loop_je], [loop_je, loop_ne], [loop_ne, loop_nw], [loop_nw, loop_jw], [loop_jw, loop_sw]]:
		edges.append([pr[0], pr[1], 0])
	edges.append([approach_end, loop_js, 0])
	edges.append([loop_js, gate_id, 0])
	edges.append([gate_id, ring[0], 0])                  # gate to the south point of the roundabout
	edges.append([ring[2], loop_je, 0])                  # east arm of the roundabout
	edges.append([ring[6], loop_jw, 0])                  # west arm
	var kerb_nodes: Array = []
	# the road up to Renowood leaves the middle of the loop road's north side as a proper T-junction and runs straight
	# north on the ordinary road kit until the hill road (Renowood) takes over
	for ei in range(edges.size()):
		var ee: Array = edges[ei]
		if (int(ee[0]) == loop_ne and int(ee[1]) == loop_nw) or (int(ee[0]) == loop_nw and int(ee[1]) == loop_ne):
			edges.remove_at(ei)
			break
	var hill_mid := nodes.size(); nodes.append(Vector2(840.0, LOOP_Z0))
	var hill_end := nodes.size(); nodes.append(Vector2(840.0, -1300.0))
	edges.append([loop_ne, hill_mid, 0])
	edges.append([hill_mid, loop_nw, 0])
	edges.append([hill_mid, hill_end, 0])
	kerb_nodes.append(hill_end)
	# access roads to the two railway stations: from the town's south-east corner to the city station's car park,
	# and from the airport approach road to the airport station's car park (the road simply ends at the car park)
	var c1 := nodes.size(); nodes.append(Vector2(191.0, 435.0))
	var c2 := nodes.size(); nodes.append(Vector2(100.0, 435.0)); kerb_nodes.append(c2)
	edges.append([id[Vector2i(3, 4)], c1, 0])
	edges.append([c1, c2, 0])
	var a1 := nodes.size(); nodes.append(Vector2(850.0, -650.0))
	var a2 := nodes.size(); nodes.append(Vector2(850.0, -604.0)); kerb_nodes.append(a2)
	edges.append([approach_end, a1, 0])
	edges.append([a1, a2, 0])
	# --- Redline Island: a second town on its own island, joined to the mainland by a long bridge from the town's
	# south-middle crossroad. 5 x 3 blocks of streets.
	var isl := {}
	for xi in range(5):
		for zi in range(3):
			isl[Vector2i(xi, zi)] = nodes.size()
			nodes.append(Vector2(-200.0 + 200.0 * xi, 1950.0 + 250.0 * zi))
	for xi in range(5):
		for zi in range(3):
			if xi + 1 < 5: edges.append([isl[Vector2i(xi, zi)], isl[Vector2i(xi + 1, zi)], 0])
			if zi + 1 < 3: edges.append([isl[Vector2i(xi, zi)], isl[Vector2i(xi, zi + 1)], 0])
	edges.append([id[Vector2i(2, 4)], isl[Vector2i(1, 0)], 0])          # the bridge, along x = 0
	# the two beach boulevards (Miami.gd) leave the island grid's four outer corners: a short straight stub from each corner makes
	# the corner a proper T-junction, and the half-circle road carries on from the stub's end
	for zi in [0, 2]:
		for xi in [0, 4]:
			var corner: int = isl[Vector2i(xi, zi)]
			var cp: Vector2 = nodes[corner]
			var stub := nodes.size()
			nodes.append(Vector2(cp.x + (-ARC_STUB if xi == 0 else ARC_STUB), cp.y))
			kerb_nodes.append(stub)
			edges.append([corner, stub, 0])
	node_kind = PackedInt32Array()
	node_kind.resize(nodes.size())
	for r in ring: node_kind[r] = 1
	for kn in kerb_nodes: node_kind[kn] = 5
	adj.resize(nodes.size())
	for i in range(nodes.size()):
		adj[i] = []
	for ei in range(edges.size()):
		var e: Array = edges[ei]
		adj[int(e[0])].append({"n": int(e[1]), "e": ei})
		adj[int(e[1])].append({"n": int(e[0]), "e": ei})
	cells = []
	hw = {}
	features = {"piers": [], "stadium": []}
	pois = [{"kind": "airport", "name": "REDLINE AIRPORT", "pos": [850.0, -930.0]}, {"kind": "city", "name": "REDLINE ISLAND", "pos": [200.0, 2200.0]}]
	_zones = PackedByteArray()
	_zones.resize(ZONE_N * ZONE_N)
	_zones.fill(Z_URBAN)
	for iz in range(ZONE_N):
		for ix in range(ZONE_N):
			var x := -half + (ix + 0.5) * half * 2.0 / ZONE_N
			var z := -half + (iz + 0.5) * half * 2.0 / ZONE_N
			if x > 550.0 and x < 1125.0 and z > -1100.0 and z < -750.0:
				_zones[iz * ZONE_N + ix] = Z_AIRPORT
	_heights = PackedFloat32Array()
	_heights.resize(HEIGHT_N * HEIGHT_N)
	is_loaded = true

static func zone_at(x: float, z: float) -> int:
	var ix := int((x + half) / (half * 2.0) * ZONE_N)
	var iz := int((z + half) / (half * 2.0) * ZONE_N)
	if ix < 0 or iz < 0 or ix >= ZONE_N or iz >= ZONE_N:
		return Z_SEA
	return _zones[iz * ZONE_N + ix]

static func is_water(x: float, z: float) -> bool:
	return Coast.is_water(x, z)

## Terrain height by bilinear sampling of the 8 m grid.
static func height_at(x: float, z: float) -> float:
	return Coast.height_at(x, z)

static func node_pos(i: int) -> Vector3:
	return Vector3(nodes[i].x, 0.0, nodes[i].y)

## Random node whose distance to `from` is within [min_d, max_d]; -1 if none found.
static func random_node_near(from: Vector3, min_d: float, max_d: float, rng: RandomNumberGenerator, kinds_ok: Array = []) -> int:
	for attempt in range(40):
		var i := rng.randi() % nodes.size()
		var d := Vector2(nodes[i].x - from.x, nodes[i].y - from.z).length()
		if d >= min_d and d <= max_d:
			if kinds_ok.is_empty(): return i
			for a in adj[i]:
				if kinds_ok.has(int(edges[a.e][2])): return i
	return -1


static var shore_tex: ImageTexture

## Distance (0..48 m) from every water cell to the nearest land, as an R8 texture over the whole map; used by the
## ocean shader for shore colour, transparency and breaking foam.
static func build_shore_texture() -> ImageTexture:
	if shore_tex != null: return shore_tex
	var n := ZONE_N
	var d := PackedFloat32Array()
	d.resize(n * n)
	var big := 1000.0
	for i in range(n * n):
		var z := _zones[i]
		d[i] = big if (z == Z_SEA or z == Z_LAKE) else 0.0
	# two-pass chamfer distance transform (cells; 1 cell = 4 m)
	for y in range(n):
		for x in range(n):
			var i := y * n + x
			var v := d[i]
			if v == 0.0: continue
			if x > 0: v = minf(v, d[i - 1] + 1.0)
			if y > 0:
				v = minf(v, d[i - n] + 1.0)
				if x > 0: v = minf(v, d[i - n - 1] + 1.414)
				if x < n - 1: v = minf(v, d[i - n + 1] + 1.414)
			d[i] = v
	for y in range(n - 1, -1, -1):
		for x in range(n - 1, -1, -1):
			var i := y * n + x
			var v := d[i]
			if v == 0.0: continue
			if x < n - 1: v = minf(v, d[i + 1] + 1.0)
			if y < n - 1:
				v = minf(v, d[i + n] + 1.0)
				if x < n - 1: v = minf(v, d[i + n + 1] + 1.414)
				if x > 0: v = minf(v, d[i + n - 1] + 1.414)
			d[i] = v
	var bytes := PackedByteArray()
	bytes.resize(n * n)
	for i in range(n * n):
		bytes[i] = int(clampf(d[i] * 4.0 / 48.0, 0.0, 1.0) * 255.0)
	var img := Image.create_from_data(n, n, false, Image.FORMAT_R8, bytes)
	shore_tex = ImageTexture.create_from_image(img)
	return shore_tex
