class_name World
extends Node3D
## The island: terrain, road network, one block per grid cell (downtown towers, shops, houses, harbour, plazas),
## plus the special blocks and districts. All layout comes from CityData (generated by tools/gen_world.py).

const SW_H := 0.15
const BLOCK := 60.0
const ROAD := 16.0
const PITCH := 76.0
const MAP_HALF := 3500.0

const SKY := ["building_02.1", "building_03.1", "building_04.1", "building_05.1", "building_06.1", "building_07.1", "building_02.2", "building_04.2"]
const SHOPS := ["Building", "Building_01", "Building_02", "Building_03", "Building_04", "Building_05", "Building_06", "Building_07", "Building_08", "Building_09"]
const TREES := ["Tree_1", "Tree_3", "Tree_4", "Tree_5", "Tree_6", "Tree_7"]
## wanted cell for each special block (grid coordinates around the centre); the nearest valid cell is used if it is taken
const SPECIAL_CELLS := {"police": Vector2i(-2, -1), "hospital": Vector2i(1, 0), "fire": Vector2i(-2, 1), "park": Vector2i(1, -2), "gas": Vector2i(0, 1)}

var rng := RandomNumberGenerator.new()
var _scenes := {}
var _bounds := {}
var sun: DirectionalLight3D
var env: Environment
var static_root: Node3D
var front_sign := 1.0        # +1 if model fronts face +Z (verified by test render)
var spawns: Array = []       # service vehicles and NPCs to spawn (filled while building, used by the game scene)
var pois: Array = []         # map markers: {kind, name, pos}
var hospital_spawn := Vector3(6.0, 0.7, 14.0)
var heli_spawn := Vector3.ZERO

var night_mats: Array = []             # [{mat, gain}] emissive materials that glow at night (sign boards, station lights)
var night_lights: Array = []           # OmniLight3D that switch on at night
var lamp_points := PackedVector3Array()   # positions of every street lamp head (night lighting)
var cell_kind := {}          # Vector2i(k, m) -> block kind

func add_poi(kind: String, poi_name: String, pos: Vector3) -> void:
	pois.append({"kind": kind, "name": poi_name, "pos": pos})

signal progress(frac: float, text: String)

func _step(frac: float, text: String) -> void:
	progress.emit(frac, text)
	await get_tree().process_frame
	await get_tree().process_frame

## Dev: `-- --area` builds only the land, roads and the town, skipping Renowood, the beaches, the railway and the districts
## (airport, harbour...), so a change to the town can be checked in a few seconds.
static func area_mode() -> bool:
	return "--area" in OS.get_cmdline_user_args()

## Dev: while true, only Redline Island is built (its roads, the bridge, the metro): no mainland town, airport, railway or hills,
## so the game starts much faster. Run with `-- --full` to build everything.
const ISLAND_ONLY := true
static func island_only() -> bool:
	return ISLAND_ONLY and not ("--full" in OS.get_cmdline_user_args())

func build() -> void:
	var t0 := Time.get_ticks_msec()
	rng.seed = 20260418
	static_root = Node3D.new()
	static_root.name = "Static"
	add_child(static_root)
	await _step(0.04, "Shaping the land and sea")
	CityData.load_all()
	_environment()
	Metro.plan()               # registers the stairwell openings in the ground before it is built
	if not Miami.ROADS_ONLY: MiamiParks.plan()          # ponds, canals and the levelled beach fair on Redline Island
	Terrain.build(self)
	await _step(0.2, "Laying the roads")
	RoadKit.build(self)
	print("build: land + roads %d ms" % (Time.get_ticks_msec() - t0))
	if island_only():
		await _step(0.52, "Planting the beaches and the bridge")
		CoastProps.build(self)
	elif not area_mode():
		await _step(0.3, "Building the airport and landmarks")
		_h_tower(Vector3(95.0, -0.2, 95.0))
		Districts.build(self)
		await _step(0.45, "Laying the railway")
		Rail.build(self)
		await _step(0.52, "Planting the beaches")
		CoastProps.build(self)
		await _step(0.62, "Raising Renowood")
		Renowood.build(self)
	await _step(0.8, "Building the town")
	if not island_only():
		CityBuild.build(self)
		if not area_mode(): CityBuild.extra_floodlights(self)
	Miami.build(self)         # Redline Island, done up as Miami
	Blimp.spawn(self)         # the advertising blimp that tours the map
	Metro.build(self)         # the metro: stairs in the town and on Redline Island, two stations, a tunnel and trains
	add_child(CityLights.new())
	await _step(0.95, "Almost there")
	print("build: done %d ms" % (Time.get_ticks_msec() - t0))

func _assign_cells() -> void:
	for c in CityData.cells:
		cell_kind[Vector2i(int(c[0]), int(c[1]))] = String(c[2])
	var taken: Array = []
	for name in SPECIAL_CELLS:
		var want: Vector2i = SPECIAL_CELLS[name]
		var best := want
		var ok: bool = (cell_kind.get(want, "") in ["urban", "downtown"]) and not taken.has(want)
		if not ok:
			var bd := 1e9
			for cc in cell_kind:
				if not (cell_kind[cc] in ["urban", "downtown"]) or taken.has(cc): continue
				var d: float = (cc - want).length()
				if d < bd:
					bd = d
					best = cc
		taken.append(best)
		cell_kind[best] = name

func _cell(k: int, m: int) -> void:
	var key := Vector2i(k, m)
	var kind: String = cell_kind[key]
	var cx := (k + 0.5) * PITCH
	var cz := (m + 0.5) * PITCH
	var gy := maxf(CityData.height_at(cx, cz), 0.0)
	if kind == "stadium": return
	var slab := _box_body(Vector3(cx, gy + SW_H / 2.0 - 0.15, cz), Vector3(BLOCK, SW_H + 0.3, BLOCK), _mat("res://assets/roads/pavement.png", 0.18, Color(1.1, 1.08, 1.05)), static_root)
	var base := Vector3(cx, gy + SW_H, cz)
	if key == H_CELL:
		_h_tower(base)
		return
	match kind:
		"downtown":
			_downtown(base)
		"urban":
			var dist := Vector2(cx, cz).length()
			var commercial := (dist < 520.0 and ((k * 7 + m * 13) % 5 != 0)) or ((k * 7 + m * 13) % 5 == 0 and dist >= 520.0)
			if commercial:
				_commercial(base)
			else:
				_lawn(base)
				_residential(base)
		"industrial":
			Districts.industrial_cell(self, base)
		"plaza":
			_lawn(base)
			for i in range(4):
				_tree(base + Vector3(rng.randf_range(-22, 22), 0, rng.randf_range(-22, 22)), rng.randf_range(7.0, 11.0))
		"police", "hospital", "fire", "gas", "park":
			Districts.special_block(self, kind, base)
	if not (kind in ["police", "hospital", "fire", "gas", "park", "industrial", "plaza", "downtown"]):
		_block_trees(base, "residential" if kind == "urban" else kind)

func _lawn(base: Vector3) -> void:
	_box_body(base + Vector3(0, 0.02, 0), Vector3(BLOCK - 8.0, 0.04, BLOCK - 8.0), _mat("res://assets/textures/y2k_grass.png", 0.2, Color(0.8, 0.95, 0.75)), static_root, false)

func _tree(pos: Vector3, height: float) -> void:
	var name: String = TREES[rng.randi() % TREES.size()]
	place("res://assets/buildings/trees/Trees/Trees.fbx", name, pos, rng.randf() * TAU, 1.0, -1.0, height, false)

# ---------------------------------------------------------------- helpers
func _mat(tex_path: String, scale: float, tint := Color.WHITE, rough := 1.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = load(tex_path) as Texture2D
	m.albedo_color = tint
	m.roughness = rough
	m.uv1_triplanar = true
	m.uv1_world_triplanar = true
	m.uv1_scale = Vector3.ONE * scale
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
	return m

func _flat(color: Color, emission := 0.0) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.roughness = 0.9
	if emission > 0.0:
		m.emission_enabled = true
		m.emission = color
		m.emission_energy_multiplier = emission
	return m

func _box_body(pos: Vector3, size: Vector3, mat: Material, parent: Node, collide := true, layer := 1) -> StaticBody3D:
	var body := StaticBody3D.new()
	body.position = pos
	body.collision_layer = layer
	var mi := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = size
	mi.mesh = bm
	mi.material_override = mat
	body.add_child(mi)
	if collide:
		var cs := CollisionShape3D.new()
		var bs := BoxShape3D.new()
		bs.size = size
		cs.shape = bs
		body.add_child(cs)
	parent.add_child(body)
	return body

func _scene(path: String) -> PackedScene:
	if not _scenes.has(path):
		_scenes[path] = load(path) as PackedScene if ResourceLoader.exists(path) else null
	return _scenes[path]

func _aabb_of(n: Node, xf: Transform3D, acc: Array) -> void:
	var t := xf
	if n is Node3D:
		t = xf * (n as Node3D).transform
	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null and (n as MeshInstance3D).visible:
		var bb: AABB = t * (n as MeshInstance3D).get_aabb()
		acc[0] = bb if acc[0] == null else (acc[0] as AABB).merge(bb)
	for c in n.get_children():
		_aabb_of(c, t, acc)

## Instantiate a model (optionally only the child named `child`) and measure it.
func make_model(path: String, child := "") -> Dictionary:
	if _scene(path) == null:
		return {"node": null, "bb": AABB()}
	var inst: Node3D = _scene(path).instantiate()
	if child != "":
		for c in inst.get_children():
			if c.name != child:
				inst.remove_child(c)
				c.free()
	var key := path + "|" + child
	if not _bounds.has(key):
		var acc := [null]
		_aabb_of(inst, Transform3D.IDENTITY, acc)
		_bounds[key] = acc[0] if acc[0] != null else AABB(Vector3.ZERO, Vector3.ONE)
	return {"node": inst, "bb": _bounds[key]}

## Place a model with its footprint centre at `pos` (ground level), rotated by `yaw`, uniformly scaled.
func place(path: String, child: String, pos: Vector3, yaw: float, scale := 1.0, target_w := -1.0, target_h := -1.0, collide := true, parent: Node = null, view_range := -1.0) -> StaticBody3D:
	if path.ends_with("lamp_cobra.glb"):
		lamp_points.append(pos + Vector3(0, (target_h if target_h > 0.0 else 6.5) * 0.96, 0))
	var md := make_model(path, child)
	if md.node == null:
		return StaticBody3D.new()          # model not supplied (yet): nothing is placed
	var inst: Node3D = md.node
	var bb: AABB = md.bb
	var s := scale
	if target_w > 0.0:
		s = target_w / maxf(bb.size.x, bb.size.z)
	if target_h > 0.0:
		s = target_h / maxf(bb.size.y, 0.01)
	var holder := StaticBody3D.new()
	holder.position = pos
	holder.rotation.y = yaw
	holder.collision_layer = 1
	var c := bb.get_center()
	inst.scale = Vector3.ONE * s
	inst.position = Vector3(-c.x * s, -bb.position.y * s, -c.z * s)
	holder.add_child(inst)
	_limit_range(inst, view_range if view_range > 0.0 else (380.0 if bb.size.y * s > 30.0 else 260.0))
	if collide:
		var cs := CollisionShape3D.new()
		var bs := BoxShape3D.new()
		bs.size = Vector3(bb.size.x * s, bb.size.y * s, bb.size.z * s)
		cs.shape = bs
		cs.position = Vector3(0, bb.size.y * s * 0.5, 0)
		holder.add_child(cs)
	(parent if parent != null else static_root).add_child(holder)
	return holder

func _environment() -> void:
	var sky_mat := ShaderMaterial.new()
	sky_mat.shader = load("res://shaders/sky.gdshader") as Shader
	sky_mat.set_shader_parameter("cloud_tex", load("res://assets/textures/sky_clouds.png"))
	var sky := Sky.new()
	sky.sky_material = sky_mat
	sky.radiance_size = Sky.RADIANCE_SIZE_128
	env = Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.9
	env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env.fog_enabled = false      # fog comes only from the weather system
	var we := WorldEnvironment.new()
	we.environment = env
	add_child(we)
	sun = DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-38, -35, 0)
	sun.light_color = Color("#fff0d0")
	sun.light_energy = 1.35
	sun.shadow_enabled = true
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
	sun.directional_shadow_max_distance = 110.0
	sun.directional_shadow_blend_splits = false
	add_child(sun)


## Stop drawing a model once it is far away (big towers stay visible further).
func _limit_range(n: Node, dist: float) -> void:
	for mi in n.find_children("*", "GeometryInstance3D", true, false):
		(mi as GeometryInstance3D).visibility_range_end = dist
		(mi as GeometryInstance3D).visibility_range_end_margin = 20.0
		(mi as GeometryInstance3D).visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_DISABLED

var _view_scale := 1.0

## Draw distance multiplier: 1 on foot / in a car, larger in the helicopter so the whole city stays visible from the air.
func set_view_scale(sc: float) -> void:
	if is_equal_approx(sc, _view_scale): return
	_view_scale = sc
	for n in static_root.find_children("*", "GeometryInstance3D", true, false):
		var g := n as GeometryInstance3D
		if not g.has_meta("vr0"):
			if g.visibility_range_end <= 0.0: continue
			g.set_meta("vr0", g.visibility_range_end)
		var base: float = g.get_meta("vr0")
		g.visibility_range_end = minf(base * sc, 1700.0)
		g.visibility_range_end_margin = 20.0 * sc

## Many copies of one model with a single draw call each (trees, rocks, lamps, ...). `xfs` are ground transforms.
## Street lamps as plain poles, used while no lamp model is supplied.
func _plain_lamps(xfs: Array, h: float) -> void:
	var pole := CylinderMesh.new()
	pole.top_radius = 0.07; pole.bottom_radius = 0.11; pole.height = h; pole.radial_segments = 6
	var head := BoxMesh.new()
	head.size = Vector3(0.9, 0.18, 0.4)
	var dark := _flat(Color("#3b3f45"))
	var glow := StandardMaterial3D.new()
	glow.albedo_color = Color(1.0, 0.95, 0.8)
	glow.emission_enabled = true
	glow.emission = Color(1.0, 0.85, 0.55)
	glow.emission_energy_multiplier = 0.2
	night_mats.append({"mat": glow, "gain": 3.0})
	for k in 2:
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = pole if k == 0 else head
		mm.instance_count = xfs.size()
		for i in range(xfs.size()):
			var xf := xfs[i] as Transform3D
			mm.set_instance_transform(i, xf.translated_local(Vector3(0, h * 0.5 if k == 0 else h, 0)))
		var mmi := MultiMeshInstance3D.new()
		mmi.multimesh = mm
		mmi.material_override = dark if k == 0 else glow
		mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		mmi.visibility_range_end = 220.0
		static_root.add_child(mmi)

func multi_place(path: String, child: String, xfs: Array, target_h := -1.0, scale := 1.0, shadows := false) -> void:
	if xfs.is_empty(): return
	if path.ends_with("lamp_cobra.glb"):
		for xf in xfs:
			lamp_points.append((xf as Transform3D).origin + Vector3(0, (target_h if target_h > 0.0 else 6.5) * 0.96, 0))
	var md := make_model(path, child)
	if md.node == null:
		if path.ends_with("lamp_cobra.glb"):
			_plain_lamps(xfs, target_h)
		return
	var inst: Node3D = md.node
	var bb: AABB = md.bb
	var s := scale
	if target_h > 0.0:
		s = target_h / maxf(bb.size.y, 0.01)
	var c := bb.get_center()
	var local := Transform3D(Basis.from_scale(Vector3.ONE * s), Vector3(-c.x * s, -bb.position.y * s, -c.z * s))
	var parts: Array = []
	_collect_meshes(inst, Transform3D.IDENTITY, parts)
	for part in parts:
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = part.mesh
		mm.instance_count = xfs.size()
		for i in range(xfs.size()):
			mm.set_instance_transform(i, (xfs[i] as Transform3D) * local * (part.xf as Transform3D))
		var mmi := MultiMeshInstance3D.new()
		mmi.multimesh = mm
		if part.mat != null:
			mmi.material_override = part.mat
		mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON if shadows else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		mmi.visibility_range_end = 420.0
		static_root.add_child(mmi)
	inst.free()

func _collect_meshes(n: Node, xf: Transform3D, out: Array) -> void:
	var t := xf
	if n is Node3D:
		t = xf * (n as Node3D).transform
	if n is MeshInstance3D and (n as MeshInstance3D).mesh != null and (n as MeshInstance3D).visible:
		out.append({"mesh": (n as MeshInstance3D).mesh, "xf": t, "mat": (n as MeshInstance3D).material_override})
	for ch in n.get_children():
		_collect_meshes(ch, t, out)

# ---------------------------------------------------------------- block content
const DT := "res://assets/buildings/downtown/%s.gltf"
const DT_BUILDINGS := ["Building_Large_2", "Building_Medium_2_001", "Building_Small_1"]

## A street-facing row of the downtown-kit buildings: brick facades with real interiors behind the windows.
func _building_rows(base: Vector3, count_per_row := 2) -> void:
	pass          # no building models supplied at the moment

const H_CELL := Vector2i(0, 0)         # the downtown block the H tower stands on
const H_LOBBY := 0.0                    # metres of open ground floor you can walk into

## The landmark tower: glowing windows at night, and solid walls only from the first floor up, so the lobby
## between and under the two towers can be walked into.
func _h_tower(base: Vector3) -> void:
	var holder := place("res://assets/buildings/landmark/the_h.glb", "", base, 0.0, 1.0, -1.0, 170.0, false, null, 1400.0)
	var seen := {}
	for mi in holder.find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		for i in range(m.mesh.get_surface_count()):
			var mat := m.get_active_material(i) as StandardMaterial3D
			if mat == null or seen.has(mat) or not mat.emission_enabled: continue
			seen[mat] = true
			if mat.resource_name == "inner_walls":
				mat.emission = Color(1.0, 0.82, 0.55)
			night_mats.append({"mat": mat, "gain": 0.6 if mat.resource_name == "inner_walls" else 3.0})
	# the paved base the towers stand on: a solid slab at the height of the model's own ground-level surfaces
	var base_bb := AABB()
	var base_first := true
	for mi in holder.find_children("*", "MeshInstance3D", true, false):
		var m3 := mi as MeshInstance3D
		var b3: AABB = Car._xf_rel(m3, holder) * m3.get_aabb()
		var mn3 := m3.mesh.surface_get_material(0)
		if mn3 != null and mn3.resource_name in ["tiled"] and b3.size.x > 6.0:
			base_bb = b3 if base_first else base_bb.merge(b3)
			base_first = false
	if not base_first:
		var scs := CollisionShape3D.new()
		var sb := BoxShape3D.new()
		sb.size = Vector3(base_bb.size.x, 1.0, base_bb.size.z)
		scs.shape = sb
		scs.position = Vector3(base_bb.get_center().x, base_bb.end.y - 0.5, base_bb.get_center().z)
		holder.add_child(scs)
	# the two towers: boxes around the floor slabs, split at the biggest gap
	var pts: Array = []
	for mi in holder.find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		var xf := Car._xf_rel(m, holder)
		for i in range(m.mesh.get_surface_count()):
			var mat := m.mesh.surface_get_material(i)
			if mat == null or mat.resource_name != "floor": continue
			var va: PackedVector3Array = m.mesh.surface_get_arrays(i)[Mesh.ARRAY_VERTEX]
			for v in va: pts.append(xf * v)
	if pts.is_empty(): return
	var lo := Vector3(1e9, 1e9, 1e9)
	var hi := Vector3(-1e9, -1e9, -1e9)
	for v in pts:
		lo = lo.min(v); hi = hi.max(v)
	var axis := 0 if (hi.x - lo.x) >= (hi.z - lo.z) else 2
	var vals: Array = []
	for v in pts: vals.append(v[axis])
	vals.sort()
	var cut := 0.0
	var gap := 0.0
	for i in range(vals.size() - 1):
		if vals[i + 1] - vals[i] > gap:
			gap = vals[i + 1] - vals[i]
			cut = (vals[i] + vals[i + 1]) * 0.5
	var boxes: Array = [[Vector3(1e9, 1e9, 1e9), Vector3(-1e9, -1e9, -1e9)], [Vector3(1e9, 1e9, 1e9), Vector3(-1e9, -1e9, -1e9)]]
	for v in pts:
		var b: Array = boxes[0 if v[axis] < cut else 1]
		b[0] = (b[0] as Vector3).min(v); b[1] = (b[1] as Vector3).max(v)
	for b in boxes:
		var bot := (b[0] as Vector3).y + H_LOBBY
		var top := (b[1] as Vector3).y
		var cs := CollisionShape3D.new()
		var bs := BoxShape3D.new()
		bs.size = Vector3((b[1] as Vector3).x - (b[0] as Vector3).x, top - bot, (b[1] as Vector3).z - (b[0] as Vector3).z)
		cs.shape = bs
		cs.position = Vector3(((b[1] as Vector3).x + (b[0] as Vector3).x) * 0.5, (top + bot) * 0.5, ((b[1] as Vector3).z + (b[0] as Vector3).z) * 0.5)
		holder.add_child(cs)

func _downtown(base: Vector3) -> void:
	pass          # no building models supplied at the moment

func _commercial(base: Vector3) -> void:
	pass          # no building models supplied at the moment

func _residential(base: Vector3) -> void:
	pass          # no building models supplied at the moment

func _block_trees(base: Vector3, kind: String) -> void:
	var count := 5 if kind == "residential" else 3
	for k in range(count):
		_tree(base + Vector3(rng.randf_range(-20, 20), 0, rng.randf_range(-8, 8)), rng.randf_range(7.0, 11.0))

# ---------------------------------------------------------------- environment
