; Redline Heights
config_version=5

[application]

run/max_fps=0
config/name="Redline Heights"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/logo_transparent.png"

[autoload]
Inputs="*res://scripts/inputs.gd"
Game="*res://scripts/game.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Vehicle"
3d_physics/layer_4="Ped"
3d_physics/layer_5="Traffic"

[physics]
common/physics_ticks_per_second=60

[rendering]
anti_aliasing/quality/msaa_3d=1
textures/canvas_textures/default_texture_filter=0
