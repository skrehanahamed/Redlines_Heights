  <library_effects>
    <effect id="Metal-effect">
      <profile_COMMON>
        <newparam sid="Metal_jpg_001-surface">
          <surface type="2D">
            <init_from>Metal_jpg_001</init_from>
          </surface>
        </newparam>
        <newparam sid="Metal_jpg_001-sampler">
          <sampler2D>
            <source>Metal_jpg_001-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Metal_jpg_001-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
